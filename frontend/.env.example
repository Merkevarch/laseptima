# La Septima Frontend - Variables de Entorno
# Copiar este archivo como .env y completar los valores

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT=tu-project-id
VITE_APPWRITE_DATABASE_ID=tu-database-id

# URL del Worker API (opcional - sin barra final)
# En desarrollo: vacio (usa proxy de Vite dev server)
# En produccion con Pages Function: vacio (el proxy functions/api/[[route]].ts lo maneja)
# En produccion sin Pages Function: https://tu-worker.tu-subdomain.workers.dev
VITE_API_URL=

# NOTA: En produccion, las llamadas /api/* son proxyadas por Cloudflare Pages Function.
# Debes configurar la variable API_WORKER_URL en:
# Cloudflare Pages > tu-proyecto > Settings > Environment variables
# Ejemplo: API_WORKER_URL=https://laseptima-api.tu-cuenta.workers.dev
