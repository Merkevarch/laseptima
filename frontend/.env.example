# La Septima Frontend - Variables de Entorno
# Copiar este archivo como .env y completar los valores

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT=tu-project-id
VITE_APPWRITE_DATABASE_ID=tu-database-id

# NOTA: El API se ejecuta como Cloudflare Pages Function (functions/api/[[route]].ts).
# En desarrollo, Vite proxy /api/* a localhost:8787 (wrangler dev).
# En produccion, las Pages Functions manejan /api/* directamente.
# No se necesita VITE_API_URL ni un Worker separado.
#
# VARIABLES DE ENTORNO DEL API (configurar en Cloudflare Dashboard):
# Ve a: Cloudflare Pages > laseptima > Settings > Environment variables
#
# APPWRITE_ENDPOINT = https://cloud.appwrite.io/v1
# APPWRITE_PROJECT = tu-project-id
# APPWRITE_API_KEY = tu-api-key (sensible - marcar como Encrypt)
# APPWRITE_DATABASE_ID = tu-database-id
# JWT_SECRET = tu-jwt-secret-minimo-32-caracteres (sensible - marcar como Encrypt)
