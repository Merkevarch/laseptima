# La Séptima - Variables de Entorno
# Copiar este archivo como .env y completar los valores

# Appwrite
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=tu-project-id
APPWRITE_DATABASE_ID=tu-database-id
APPWRITE_API_KEY=tu-api-key

# JWT (para autenticación de meseros)
JWT_SECRET=tu-jwt-secret-minimo-32-caracteres

# Print Bridge
PRINT_BRIDGE_PORT=3001
